<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>id</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>id</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>KAPDH</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>KAPDH</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Skema aplikasi kapdh://app/<rute> untuk deep link notifikasi (ARCHITECTURE §4.7, AC F13-3). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>id.or.kapdh.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kapdh</string>
			</array>
		</dict>
	</array>
	<!-- Deep link diteruskan ke go_router; otorisasi tetap diperiksa redirect. -->
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Skema yang boleh dibuka url_launcher (email dan WhatsApp bantuan). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mailto</string>
		<string>https</string>
	</array>
	<!-- image_picker: bukti transfer dan foto profil (F-03, F-10), foto chat dan foto grup (F-11). Kamera tidak
	     dipakai untuk foto grup (hanya galeri). Perbarui bersama app-store-submission.md bagian 5 dan 10. -->
	<key>NSCameraUsageDescription</key>
	<string>Kamera dipakai saat Anda memilih memotret bukti transfer, foto profil, atau foto yang dikirim di chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Galeri dipakai saat Anda memilih gambar untuk bukti transfer, foto profil, foto di chat, atau foto grup.</string>
	<!-- Push FCM/APNs (F-13); notifikasi diterima di latar belakang. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Auto-init FCM mati: token FCM dan Installation ID tidak dibuat saat aplikasi dibuka, dan plugin baru
	     mendaftarkan APNs setelah PushService menyalakan auto-init (setelah login, bila izin notifikasi tidak
	     ditolak). Keputusan K8 di app-store-submission.md. -->
	<key>FirebaseMessagingAutoInitEnabled</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
