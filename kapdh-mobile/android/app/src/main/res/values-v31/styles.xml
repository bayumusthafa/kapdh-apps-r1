<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+: splash sistem memakai latar hijau gelap KAPDH (bukan putih bawaan) dengan ikon adaptif, menyatu
      dengan layar splash Flutter (PRD 4.6 Flutter sistem).
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/kapdh_launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
