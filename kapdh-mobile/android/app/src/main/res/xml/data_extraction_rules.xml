<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: tidak ada data aplikasi yang ikut cadangan cloud atau transfer antarperangkat. Token sesi, snapshot
  /me, cache KTA dan kunci idempotensi hanya berlaku di perangkat ini (PRD 5.2, N-09).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
