<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- API, realtime dan push (PRD 5.1). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: izin notifikasi diminta saat runtime; aplikasi tetap berfungsi bila ditolak (AC F13-2). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup=false dan aturan ekstraksi data: token sesi, snapshot profil, cache KTA dan kunci idempotensi
      tidak ikut cadangan cloud maupun transfer antarperangkat (PRD 5.2, N-09).
    -->
    <application
        android:label="KAPDH"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Tema jendela selama Flutter memulai. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <!-- Deep link diteruskan ke go_router; otorisasi tetap diperiksa redirect (AC F13-3). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Skema aplikasi: kapdh://app/<rute> (ARCHITECTURE §4.7). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kapdh" android:host="app" />
            </intent-filter>
            <!--
              App Links: https://kapdh.or.id/app dan https://kapdh.or.id/app/<rute>. Verifikasi membutuhkan
              https://kapdh.or.id/.well-known/assetlinks.json berisi sidik sertifikat rilis (runbook rilis).
              pathPrefix dicocokkan sebagai awalan string, sehingga "/app" saja juga merebut /apply, /apps dan
              sebagainya; karena itu dipakai path persis "/app" ditambah awalan "/app/" (sama dengan DeepLinks).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="kapdh.or.id" />
                <data android:path="/app" />
                <data android:pathPrefix="/app/" />
            </intent-filter>
        </activity>

        <!-- Kanal notifikasi bawaan FCM; dibuat aplikasi saat PushService dimulai. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="kapdh_umum" />
        <!-- Jangan hapus: dipakai Flutter tool untuk membangkitkan GeneratedPluginRegistrant. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Visibilitas paket (Android 11+): proses teks, tautan https, email dan WhatsApp bantuan (url_launcher). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
