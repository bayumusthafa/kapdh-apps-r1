{
  "name": "@kapdh/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web admin KAPDH (React 19, Vite 8, TanStack, Tailwind 4).",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@kapdh/contracts": "workspace:*",
    "@kapdh/design-tokens": "workspace:*",
    "@kapdh/shared": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
