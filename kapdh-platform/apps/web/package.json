{
  "name": "@kapdh/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Situs publik kapdh.or.id (Astro static): beranda, unduh aplikasi, halaman legal/informasi, kontak, verifikasi KTA, hapus akun.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/assert-csp-safe.mjs",
    "preview": "astro preview",
    "typecheck": "astro check && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0",
    "@kapdh/contracts": "workspace:*",
    "@kapdh/design-tokens": "workspace:*",
    "@kapdh/shared": "workspace:*",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
