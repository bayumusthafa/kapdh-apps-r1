---
import Base from "../layouts/Base.astro";
---
<Base title="Beranda">
  <section class="flex flex-col gap-4 py-6">
    <h1 class="font-heading text-display font-semibold text-primary">Platform Alumni KAPDH</h1>
    <p class="max-w-2xl text-body-lg">Menghubungkan Keluarga Alumni Pondok Pesantren Darel Hikmah di seluruh Indonesia: KTA digital, jejaring alumni, event dan tiket.</p>
  </section>
  <section id="unduh" class="flex flex-col gap-3 rounded-lg bg-surface-dark p-6 text-text-on-dark">
    <h2 class="font-heading text-h2 font-semibold text-accent">Unduh aplikasi</h2>
    <p class="text-sm text-green-100">Tautan Google Play dan App Store ditambahkan setelah aplikasi disetujui toko.</p>
  </section>
</Base>
