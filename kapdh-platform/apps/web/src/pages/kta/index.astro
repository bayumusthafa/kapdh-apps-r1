---
import Base from "../../layouts/Base.astro";
// Shell /kta/{nomor}#t=<token> (F-06): nginx melayani file ini untuk setiap /kta/<nomor> (infra/nginx-web.conf).
---

<Base title="Verifikasi KTA" description="Verifikasi status kartu tanda anggota KAPDH dari QR." noindex>
  <section data-surface="dark" class="bg-surface-dark text-text-on-dark">
    <div class="mx-auto flex max-w-xl flex-col gap-2 px-4 py-8 sm:px-6">
      <p class="text-sm font-semibold tracking-wide text-accent uppercase">Pemeriksa KTA</p>
      <h1 class="font-heading text-3xl font-bold">Verifikasi KTA</h1>
      <p class="text-sm text-green-100">Status dibaca langsung dari server KAPDH saat QR dipindai.</p>
    </div>
  </section>
  <div class="mx-auto flex max-w-xl flex-col gap-5 px-4 py-8 sm:px-6">
    <div id="kta-result" role="status" aria-live="polite" aria-busy="true" class="card min-h-36 p-5">
      <noscript>
        <p class="text-sm">Aktifkan JavaScript untuk memverifikasi KTA.</p>
      </noscript>
    </div>
    <button id="kta-retry" type="button" hidden disabled class="btn-outline self-start">Coba lagi</button>
    <div class="info-box flex flex-col gap-1 text-xs text-neutral-700">
      <p>
        Hasil ini hanya berlaku saat diperiksa. Kartu offline di aplikasi bukan bukti status terkini; pemeriksaan selalu
        memakai status server.
      </p>
      <p>Halaman ini tidak menampilkan kontak, alamat, atau data pribadi lain anggota.</p>
    </div>
  </div>
</Base>

<script>
  import { readApiBase } from "../../scripts/api";
  import { byId } from "../../scripts/dom";
  import { mountKtaPage } from "../../scripts/kta-page";

  void mountKtaPage({
    doc: document,
    root: byId(document, "kta-result"),
    retryButton: byId<HTMLButtonElement>(document, "kta-retry"),
    apiBase: readApiBase(),
    getLocation: () => ({ pathname: location.pathname, hash: location.hash }),
  }).run();
</script>
