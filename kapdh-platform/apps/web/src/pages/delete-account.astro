---
import Base from "../layouts/Base.astro";
// /delete-account (F-14, R1/R2): permintaan penghapusan benar-benar diterima di sini dengan challenge email,
// bukan sekadar petunjuk menghubungi pengurus. Alur interaktif ada di scripts/delete-account-page.ts.
---

<Base
  title="Hapus Akun"
  description="Minta penghapusan akun KAPDH dan data terkait tanpa memasang aplikasi, atau periksa status permintaan."
  noindex
  maintenanceBanner
>
  <section class="border-b border-divider bg-surface">
    <div class="mx-auto flex max-w-2xl flex-col gap-3 px-4 py-10 sm:px-6">
      <h1 class="font-heading text-3xl font-bold text-green-950 sm:text-4xl">Hapus akun KAPDH</h1>
      <p class="text-text-muted">
        Ajukan penghapusan akun beserta data terkait tanpa memasang aplikasi, atau periksa status permintaan yang sudah
        diajukan. Di aplikasi, buka <strong class="font-semibold text-text">Akun &rsaquo; Hapus akun</strong>.
      </p>
    </div>
  </section>

  <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[1.5fr_1fr]">
    <div id="del-app" class="card p-5 sm:p-7">
      <noscript>
        <p class="text-sm">
          Halaman ini memerlukan JavaScript untuk memverifikasi email Anda. Bila tidak dapat mengaktifkannya, kirim
          permintaan dari email akun Anda ke bantuan@kapdh.or.id.
        </p>
      </noscript>
    </div>

    <aside aria-labelledby="ringkas-h" class="flex flex-col gap-4 text-sm">
      <h2 id="ringkas-h" class="font-heading text-xl font-semibold text-green-950">Yang terjadi saat akun dihapus</h2>
      <ul class="flex flex-col gap-3">
        <li class="flex gap-3">
          <span class="mt-1.5 size-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
          Kredensial, profil, kontak, foto, unggahan pribadi, file bukti transfer, dan isi chat Anda dihapus.
        </li>
        <li class="flex gap-3">
          <span class="mt-1.5 size-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
          Catatan pembayaran, tiket, laporan moderasi, dan audit hanya tersisa tanpa nama, email, telepon, atau foto.
        </li>
        <li class="flex gap-3">
          <span class="mt-1.5 size-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
          Semua sesi di aplikasi langsung dikeluarkan. Penghapusan selesai paling lama 7 hari dan Anda menerima email
          pemberitahuan.
        </li>
        <li class="flex gap-3">
          <span class="mt-1.5 size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          Tiket event aktif hangus. Ajukan pembatalan atau refund lebih dahulu dan tunggu refund selesai sebelum menghapus
          akun.
        </li>
      </ul>
      <p class="text-text-muted">
        Rincian penyimpanan data ada di <a href="/kebijakan-privasi" class="font-semibold text-primary underline">Kebijakan Privasi</a>.
        Pertanyaan? <a href="/kontak" class="font-semibold text-primary underline">Hubungi kami</a>.
      </p>
    </aside>
  </div>
</Base>

<script>
  import { readApiBase } from "../scripts/api";
  import { fetchPublicConfigTimed } from "../scripts/config";
  import { mountConfigConsumers } from "../scripts/config-page";
  import { mountDeleteAccount } from "../scripts/delete-account-page";
  import { byId } from "../scripts/dom";

  const apiBase = readApiBase();
  const config = fetchPublicConfigTimed(apiBase);
  mountDeleteAccount({ doc: document, root: byId(document, "del-app"), apiBase, config });
  void mountConfigConsumers(
    document,
    apiBase,
    undefined,
    config.then((c) => c.result),
  );
</script>
