{
  "name": "@kapdh/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS 11 (Fastify) KAPDH Apps.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "admin:bootstrap": "node dist/cli/bootstrap-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@kapdh/config": "workspace:*",
    "@kapdh/contracts": "workspace:*",
    "@kapdh/database": "workspace:*",
    "@kapdh/shared": "workspace:*",
    "@kapdh/storage": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nodemailer": "10.1.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "7.8.5",
    "uuid": "14.0.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/semver": "7.8.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "embedded-postgres": "17.6.0-beta.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "type": "module"
}
