{
  "name": "@kapdh/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime worker KAPDH: dispatcher outbox, antrean BullMQ/inline, penjadwal ber-leader, health, shutdown halus (PRD 5.1, 5.5, N-14).",
