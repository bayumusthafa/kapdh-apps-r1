    "@kapdh/config": "workspace:*",
    "@kapdh/database": "workspace:*",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "uuid": "14.0.3",
    "vitest": "5.0.3"
  }
}
