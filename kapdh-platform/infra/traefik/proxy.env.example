# Contoh environment Traefik cadangan (infra/compose.proxy.yml; D12, N-07). Tanpa secret.
#   cp infra/traefik/proxy.env.example /etc/kapdh/proxy.env && chmod 600 /etc/kapdh/proxy.env
ACME_EMAIL=ganti-dengan-email-pengelola-infra@kapdh.or.id
KAPDH_PRODUCTION_DOMAIN_WEB=kapdh.or.id
KAPDH_PRODUCTION_DOMAIN_ADMIN=admin.kapdh.or.id
KAPDH_PRODUCTION_DOMAIN_API=api.kapdh.or.id
# www.kapdh.or.id → kapdh.or.id (permanen).
KAPDH_PRODUCTION_WWW_REDIRECT=true
# Staging (opsional; ketiganya atau kosong semua). Kosongkan bila staging tidak dijalankan lewat Compose cadangan.
KAPDH_STAGING_DOMAIN_WEB=staging.kapdh.or.id
KAPDH_STAGING_DOMAIN_ADMIN=staging-admin.kapdh.or.id
KAPDH_STAGING_DOMAIN_API=staging-api.kapdh.or.id
# N-07: true hanya setelah SELURUH subdomain kapdh.or.id (termasuk panel Coolify dan monitor) siap HTTPS.
KAPDH_HSTS=false
