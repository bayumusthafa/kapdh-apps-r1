# syntax=docker/dockerfile:1.26.0@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# Image situs publik kapdh.or.id (apps/web, Astro static; D12, PRD 4.6, 7.1; N-07). Dibangun di CI, bukan di VPS
# production (PRD 5.3, 10.2). Konteks build = kapdh-platform/ (berkas lokal disaring .dockerignore). URL API dibakukan
# Astro saat build, jadi staging dan production adalah dua varian image dari commit yang sama (infra/ci/images.json):
#
#   docker build -f infra/Dockerfile.web --build-arg KAPDH_COMMIT=$(git rev-parse HEAD) -t kapdh-web:<versi> .
#   docker build -f infra/Dockerfile.web --build-arg PUBLIC_API_URL=https://staging-api.kapdh.or.id/api/v1 \
#     --build-arg KAPDH_COMMIT=$(git rev-parse HEAD) -t kapdh-web:<versi>-staging .
#
# Build menjalankan gerbang CSP situs (apps/web/scripts/assert-csp-safe.mjs) dan menulis berkas asosiasi tautan
# aplikasi dari apps/web/app-links.json (apps/web/scripts/write-app-links.mjs); header ada di infra/nginx-web.conf.
# Base image dipin versi patch + digest (PRD 7.1); nginx berjalan sebagai user nginx (uid 101) di port 8080
# (infra/nginx-main.conf).

# ------------------------------------------------------------------------------------------------ tahap build
FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /repo
ENV CI=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN --mount=type=cache,id=kapdh-pnpm-store,target=/pnpm/store \
    pnpm fetch --frozen-lockfile --store-dir /pnpm/store
COPY . .
# D12: production api.kapdh.or.id; build menolak URL non-https selain localhost (apps/web/src/lib/site.ts).
ARG PUBLIC_API_URL=https://api.kapdh.or.id/api/v1
ENV PUBLIC_API_URL=${PUBLIC_API_URL}
RUN --mount=type=cache,id=kapdh-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline --store-dir /pnpm/store --filter "@kapdh/web..." \
  && pnpm --filter "@kapdh/web..." build \
  && test -f apps/web/dist/index.html \
  && test -f apps/web/dist/kta/index.html \
  && test -f apps/web/dist/app/index.html \
  && test -f apps/web/dist/404.html

# ---------------------------------------------------------------------------------------------- tahap runtime
# nginx 1.30.6 stable (Alpine 3.24), digest dipin (PRD 7.1).
FROM nginx:1.30.6-alpine3.24@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5
COPY infra/nginx-main.conf /etc/nginx/nginx.conf
COPY infra/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
# Commit sumber image di /version.json: uji asap deploy membuktikan kontainer yang melayani trafik adalah digest
# yang dipromosikan (infra/ci/smoke.mjs). Bukan secret.
ARG KAPDH_COMMIT=""
RUN case "$KAPDH_COMMIT" in \
      "") ;; \
      *[!0-9a-f]*) echo "KAPDH_COMMIT wajib 40 heksadesimal huruf kecil" >&2; exit 1 ;; \
      *) [ "${#KAPDH_COMMIT}" -eq 40 ] || { echo "KAPDH_COMMIT wajib 40 heksadesimal" >&2; exit 1; } ;; \
    esac \
  && printf '{"commit":"%s"}\n' "$KAPDH_COMMIT" > /usr/share/nginx/html/version.json
# Pengguna non-root `nginx` (uid 101) dari image resmi; berkas situs milik root dan hanya-baca.
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
STOPSIGNAL SIGQUIT
# Langsung nginx tanpa skrip docker-entrypoint.d (envsubst/IPv6 tidak dipakai; konfigurasi sudah final saat build).
ENTRYPOINT ["nginx", "-g", "daemon off;"]
