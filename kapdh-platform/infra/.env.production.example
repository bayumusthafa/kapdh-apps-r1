# Contoh environment PRODUCTION KAPDH (PRD 5.3, 5.5; D7, D9, D10, D12). TANPA SECRET: setiap nilai `ganti-dengan-...`
# wajib diganti dan validasi packages/config menolak placeholder ini di staging/production (aplikasi gagal start).
#
# Pemakaian:
#   - Coolify (jalur utama): isi variabel bagian A per resource API dan worker di panel; tandai secret sebagai
#     "secret/locked". Nilai DATABASE_URL dan REDIS_URL ditulis lengkap per resource (lihat bagian B). Job migrasi/rilis
#     TIDAK dikonfigurasi di panel; ada dua pelaksana dengan berkas dan NAMA VARIABEL berbeda (runbook rilis bagian 1):
#       * otomatis (utama): CI -> SSH forced command infra/ci/remote-migrate.sh, berkas
#         /etc/kapdh/ci-migrate/production.env: KAPDH_ADMIN_DATABASE_URL, KAPDH_MIGRATOR_DATABASE_URL,
#         KAPDH_RELEASE_GATE, KAPDH_RELEASE_GATE_REASON, KAPDH_RELEASE_GATE_APPROVER (docs/runbooks/ci-cd.md bagian 5).
#         Nama tanpa awalan KAPDH_ ditolak di sana.
#       * manual: infra/scripts/run-release.sh, berkas /etc/kapdh/production/release.env (root, 600):
#         ADMIN_DATABASE_URL, MIGRATOR_DATABASE_URL, KAPDH_*_DB_PASSWORD, RELEASE_GATE, RELEASE_GATE_REASON,
#         RELEASE_GATE_APPROVER (nama yang sama dengan bagian C di bawah).
#   - Compose cadangan (panel Coolify mati; docs/runbooks/compose-cadangan.md):
#       cp infra/.env.production.example /etc/kapdh/production.env && chmod 600 /etc/kapdh/production.env
#       docker compose --env-file /etc/kapdh/production.env -f infra/compose.production.yml up -d
#     Compose menyusun DATABASE_URL/REDIS_URL sendiri dari sandi di bagian C, dan hanya meneruskan variabel yang
#     dibutuhkan tiap layanan (worker tidak menerima secret JWT/OTP/TOTP/QR, PRD 5.1).
# Jangan commit berkas yang sudah terisi (.gitignore menolak .env.*). Simpan di pengelola secret + salinan offline (D9).
# Buat secret acak: `openssl rand -hex 32` (heksadesimal aman dipakai di URL tanpa percent-encoding).

# ===================================================================================== A. bersama (API dan worker)
NODE_ENV=production
LOG_LEVEL=info
# D12: situs publik, web admin dan API pada site yang sama (cookie refresh admin SameSite, PRD 5.2).
PUBLIC_WEB_URL=https://kapdh.or.id
API_PUBLIC_URL=https://api.kapdh.or.id
ADMIN_ORIGIN=https://admin.kapdh.or.id
# D10: provider transaksional (SES/Brevo/Mailgun/Resend/Postmark), pengirim noreply@ dengan SPF/DKIM/DMARC. Wajib.
SMTP_URL=smtps://ganti-dengan-user:ganti-dengan-sandi@smtp.ganti-dengan-provider.example:465
MAIL_FROM="KAPDH <noreply@kapdh.or.id>"
# PRD 5.4: local (volume /data/files) sampai pemicu perpindahan D9 (disk > 60% atau berkas > 20 GB).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/files
# Diisi hanya bila STORAGE_DRIVER=s3 (setelah perpindahan terverifikasi, PRD 5.4).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Hanya selama perpindahan local -> S3 (STORAGE_DRIVER=s3; docs/runbooks/storage-migration.md): folder disk lama
# (mis. /data/files) yang dibaca bila objek belum ada di bucket. Kosong di luar perpindahan.
STORAGE_FALLBACK_LOCAL_ROOT=
# HMAC token URL berkas privat (<= 10 menit, PRD 5.4). >= 32 karakter, unik per lingkungan.
FILE_URL_SECRET=ganti-dengan-32-karakter-acak-atau-lebih
# Push FCM production (wajib di production, F-13). JSON akun layanan SATU baris (client_email, private_key).
FCM_PROJECT_ID=ganti-dengan-proyek-fcm-production
FCM_SERVICE_ACCOUNT_JSON=
# Pelacakan galat GlitchTip (docs/runbooks/monitoring.md bagian 5). Kosong = nonaktif. DSN proyek TERPISAH untuk API
# dan worker (Coolify: per resource; Compose: SENTRY_DSN untuk API dan SENTRY_DSN_WORKER di bagian C untuk worker).
# SENTRY_ENVIRONMENT kosong = NODE_ENV; SENTRY_RELEASE kosong = KAPDH_IMAGE_TAG (Compose) atau tag image (Coolify).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# ================================================================================================== API saja
PORT=3000
# Satu hop proxy tepercaya (Traefik) agar req.ip benar untuk rate limit (PRD 2.5).
TRUST_PROXY_HOPS=1
# N-07: true hanya setelah SELURUH subdomain kapdh.or.id siap HTTPS (includeSubDomains).
HSTS_ENABLED=false
JWT_ACCESS_SECRET=ganti-dengan-32-karakter-acak-atau-lebih
JWT_ISSUER=https://api.kapdh.or.id
# key_id:secret dipisah koma; kunci pertama menandatangani QR KTA, semua kunci memverifikasi (rotasi). key_id
# berawalan "dev" ditolak di production.
QR_SIGNING_KEYS=prod-2027a:ganti-dengan-32-karakter-acak-atau-lebih
OTP_HMAC_SECRET=ganti-dengan-32-karakter-acak-atau-lebih
# 32 byte hex (64 karakter) untuk AES-256-GCM secret TOTP admin. Tidak boleh nol semua. JANGAN dirotasi tanpa
# migrasi ulang secret TOTP (seluruh admin harus mendaftar ulang).
TOTP_ENC_KEY=ganti-dengan-64-karakter-hex-dari-openssl-rand-hex-32
# PRD 2.5: dikalibrasi terhadap VPS (minimal 10 di production).
BCRYPT_COST=12

# =============================================================================================== worker saja
# Total job paralel per proses (>= 2 agar selalu ada koneksi cadangan untuk heartbeat lease).
WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=3001
WORKER_HEALTH_HOST=0.0.0.0
OUTBOX_POLL_INTERVAL_MS=2000
# stop_grace_period kontainer worker > nilai ini + 10 detik (compose: 40 detik).
WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Deletion ledger DI LUAR VPS (AC F14-6, D5-07; docs/runbooks/backup-restore.md bagian 3): bucket S3-compatible KHUSUS
# (versioning + object lock/retensi), terpisah dari bucket berkas dan repositori backup, kredensial cukup hak tulis
# objek. WAJIB untuk worker production (worker menolak start tanpa bucket). API TIDAK menerimanya (PRD 5.1).
# Endpoint kosong = AWS S3; isi untuk R2/B2/penyedia lain.
DELETION_LEDGER_S3_ENDPOINT=
DELETION_LEDGER_S3_REGION=ganti-dengan-region-ledger
DELETION_LEDGER_S3_BUCKET=ganti-dengan-bucket-ledger
DELETION_LEDGER_S3_ACCESS_KEY_ID=ganti-dengan-kunci-tulis-ledger
DELETION_LEDGER_S3_SECRET_ACCESS_KEY=ganti-dengan-secret-tulis-ledger
DELETION_LEDGER_S3_FORCE_PATH_STYLE=false

# ============================================== B. koneksi (Coolify: tulis lengkap per resource; Compose: abaikan)
# API    DATABASE_URL=postgres://kapdh_app:<KAPDH_APP_DB_PASSWORD>@<host-db>:5432/kapdh
# worker DATABASE_URL=postgres://kapdh_worker:<KAPDH_WORKER_DB_PASSWORD>@<host-db>:5432/kapdh
# rilis  ADMIN_DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@<host-db>:5432/kapdh
#        MIGRATOR_DATABASE_URL=postgres://kapdh_migrator:<KAPDH_MIGRATOR_DB_PASSWORD>@<host-db>:5432/kapdh
# API/worker REDIS_URL=redis://:<REDIS_PASSWORD>@<host-redis>:6379/0
# PostgreSQL dan Redis TIDAK pernah dipublikasikan ke internet (PRD 5.3, N-07): hanya jaringan Docker internal.

# ====================================================================================== C. Compose cadangan
# Tag image yang lulus gerbang rilis (PRD 5.5: image yang sama dengan staging untuk api/worker/release).
KAPDH_REGISTRY=ghcr.io/ganti-dengan-organisasi
KAPDH_IMAGE_TAG=ganti-dengan-tag-rilis
# Domain dirutekan Traefik cadangan dari berkas terpisah (infra/traefik/proxy.env.example). NODE_ENV dan nama project
# (kapdh-production) dipatok berkas compose.
# Volume yang sudah ada (mis. volume data resource PostgreSQL/Redis Coolify, atau hasil restore) dapat dipakai ulang;
# kosong = kapdh-production-pgdata / kapdh-production-redisdata. JANGAN pernah dipakai dua kontainer PostgreSQL bersamaan.
KAPDH_PGDATA_VOLUME=
KAPDH_REDISDATA_VOLUME=
# Direktori host berkas (PRD 5.4) yang juga di-mount resource API/worker Coolify; milik uid 1000, mode 750.
KAPDH_FILES_DIR=/srv/kapdh/production/files
# Superuser PostgreSQL (inisialisasi volume, job rilis untuk roles.sql). Hanya dipakai kontainer postgres dan rilis.
POSTGRES_PASSWORD=ganti-dengan-64-karakter-hex
# Sandi role LOGIN (infra/db/roles.sql; diterapkan job rilis lewat infra/db/role-passwords.sql).
KAPDH_MIGRATOR_DB_PASSWORD=ganti-dengan-64-karakter-hex
KAPDH_APP_DB_PASSWORD=ganti-dengan-64-karakter-hex
KAPDH_WORKER_DB_PASSWORD=ganti-dengan-64-karakter-hex
# Role backup harian dan pemeriksa kesehatan (infra/backup, infra/monitoring; roles.sql). Opsional: kosong = sandi
# tidak diubah job rilis (atur manual, docs/runbooks/backup-restore.md bagian 3).
KAPDH_BACKUP_DB_PASSWORD=
KAPDH_MONITOR_DB_PASSWORD=
# DSN GlitchTip proyek worker (Compose; API memakai SENTRY_DSN di bagian A). Kosong = nonaktif.
SENTRY_DSN_WORKER=
# Redis privat dengan sandi (requirepass); BullMQ, rate limit lintas replica, adapter Socket.IO.
REDIS_PASSWORD=ganti-dengan-64-karakter-hex
# Gerbang go-live job rilis: enforce (bawaan production). `report` = PENGECUALIAN (inisialisasi pertama PRD 8.2, atau
# hotfix mendesak saat pemeriksaan konfigurasi yang tidak terkait sedang merah) dan wajib disertai alasan + penyetuju
# (pemilik produk/Super Admin, D9); keduanya dicetak ke log job untuk paket bukti. Isi hanya saat pengecualian, lalu
# kosongkan kembali. Runbook rilis bagian 5.3. Hanya untuk job rilis Compose/manual (release-job.sh, run-release.sh);
# job migrasi CI (remote-migrate.sh) memakai KAPDH_RELEASE_GATE* di /etc/kapdh/ci-migrate/production.env.
RELEASE_GATE=enforce
RELEASE_GATE_REASON=
RELEASE_GATE_APPROVER=
