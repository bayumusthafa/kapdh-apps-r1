# Konfigurasi pemeriksa monitoring KAPDH di VPS (infra/monitoring; docs/runbooks/monitoring.md). Salin ke
# /etc/kapdh/monitoring.env (chmod 600, milik root). URL Push Uptime Kuma berisi token: perlakukan sebagai secret.
# Uptime Kuma sendiri berjalan DI LUAR VPS production (monitor eksternal, N-05).

# Database untuk check-app.sh: role kapdh_monitor (infra/db/roles.sql, hanya kolom status/waktu). Sandi lewat
# PGPASSWORD di berkas ini (0600). PostgreSQL production tidak diterbitkan ke host (jaringan Docker internal), jadi psql
# dijalankan di kontainer PostgreSQL: Compose cadangan kapdh-production-postgres-1; Coolify: nama kontainer resource
# PostgreSQL (`docker ps --format '{{.Names}}'`).
PGDATABASE=kapdh
PGUSER=kapdh_monitor
PG_EXEC="docker exec -i -e PGUSER -e PGPASSWORD -e PGDATABASE kapdh-production-postgres-1"
# Alternatif hanya bila PostgreSQL sengaja diterbitkan ke loopback host dan klien 17 terpasang (hapus PG_EXEC):
# PGHOST=127.0.0.1
# PGPORT=5432
# PGPASSFILE=/etc/kapdh/pgpass-monitor

# Ambang (bawaan sesuai runbook).
OUTBOX_MAX_AGE_S=300
PUSH_PROVIDER_MAX=20
EMAIL_PROVIDER_MAX=5
PAYMENT_REVIEW_MAX_HOURS=48
# Path DI HOST. Berkas lokal = direktori host yang di-bind ke /data/files kontainer API/worker (Coolify dan Compose
# cadangan sama: KAPDH_FILES_DIR, /srv/kapdh/production/files).
DISK_PATHS="/ /srv/kapdh/production/files /var/lib/docker"
DISK_WARN_PCT=60
DISK_CRIT_PCT=80
FILES_ROOT=/srv/kapdh/production/files
FILES_MAX_GB=20

# Worker: salah satu.
# WORKER_HEALTH_URL=http://127.0.0.1:3001/healthz
# Coolify mengganti nama kontainer setiap deploy: pakai filter, mis. WORKER_CONTAINER=label=coolify.resourceName=kapdh-worker
WORKER_CONTAINER=

# Realtime probe (node infra/monitoring/realtime-probe.mjs).
REALTIME_URL=https://api.kapdh.or.id

# URL monitor Push Uptime Kuma (https://<kuma>/api/push/<token>), satu per monitor. URL salinan Kuma yang membawa
# `?status=up&msg=OK&ping=` boleh dipakai: query bawaan dibuang skrip (bila tidak, Kuma mencatat setiap heartbeat DOWN).
KUMA_PUSH_DISK_WARN=
KUMA_PUSH_DISK_CRIT=
KUMA_PUSH_OUTBOX=
KUMA_PUSH_PROVIDERS=
KUMA_PUSH_DELETIONS=
KUMA_PUSH_PAYMENTS=
KUMA_PUSH_WORKER=
KUMA_PUSH_REALTIME=
# Untuk check-backup.sh (memakai konfigurasi backup.env + backup.secrets.env untuk akses repositori restic).
KUMA_PUSH_BACKUP_AGE=
KUMA_PUSH_BACKUP_CHECK=
