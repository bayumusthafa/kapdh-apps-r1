# Konfigurasi pemeriksa monitoring KAPDH di VPS (infra/monitoring; docs/runbooks/monitoring.md). Salin ke
# /etc/kapdh/monitoring.env (chmod 600, milik root). URL Push Uptime Kuma berisi token: perlakukan sebagai secret.
# Uptime Kuma sendiri berjalan DI LUAR VPS production (monitor eksternal, N-05).

# Database untuk check-app.sh: role kapdh_monitor (infra/db/roles.sql, hanya kolom status/waktu).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=kapdh
PGUSER=kapdh_monitor
# PGPASSFILE=/etc/kapdh/pgpass-monitor
# PG_EXEC="docker exec -i -e PGUSER -e PGPASSWORD -e PGDATABASE <nama-kontainer-postgres>"

# Ambang (bawaan sesuai runbook).
OUTBOX_MAX_AGE_S=300
PUSH_PROVIDER_MAX=20
EMAIL_PROVIDER_MAX=5
PAYMENT_REVIEW_MAX_HOURS=48
DISK_PATHS="/ /data/files /var/lib/docker"
DISK_WARN_PCT=60
DISK_CRIT_PCT=80
FILES_ROOT=/data/files
FILES_MAX_GB=20

# Worker: salah satu.
# WORKER_HEALTH_URL=http://127.0.0.1:3001/healthz
WORKER_CONTAINER=

# Realtime probe (node infra/monitoring/realtime-probe.mjs).
REALTIME_URL=https://api.kapdh.or.id

# URL monitor Push Uptime Kuma (https://<kuma>/api/push/<token>), satu per monitor.
KUMA_PUSH_DISK_WARN=
KUMA_PUSH_DISK_CRIT=
KUMA_PUSH_OUTBOX=
KUMA_PUSH_PROVIDERS=
KUMA_PUSH_DELETIONS=
KUMA_PUSH_PAYMENTS=
KUMA_PUSH_WORKER=
KUMA_PUSH_REALTIME=
# Untuk check-backup.sh (memakai konfigurasi backup.env + backup.secrets.env untuk akses repositori restic).
KUMA_PUSH_BACKUP_AGE=
KUMA_PUSH_BACKUP_CHECK=
