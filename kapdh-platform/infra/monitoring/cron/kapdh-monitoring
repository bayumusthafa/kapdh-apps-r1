# Jadwal pemeriksa monitoring KAPDH (docs/runbooks/monitoring.md bagian 2.1): /etc/cron.d/kapdh-monitoring, milik root,
# mode 0644. Selalu dipasang, terlepas dari pilihan jadwal backup (systemd timer atau infra/backup/cron/kapdh-backup).
# Semua jadwal berupa interval (tidak bergantung zona waktu host); restic check mingguan dipilih check-backup.sh sendiri
# dari CHECK_WEEKDAY/CHECK_HOUR_UTC (UTC). Keluaran ke syslog lewat logger; pesan heartbeat hanya angka dan kode isu.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

40 * * * *   root  KAPDH_BACKUP_ENV=/etc/kapdh/backup.env KAPDH_BACKUP_SECRETS=/etc/kapdh/backup.secrets.env /opt/kapdh/infra/monitoring/check-backup.sh 2>&1 | logger -t kapdh-check-backup
*/5 * * * *  root  KAPDH_BACKUP_ENV=/etc/kapdh/monitoring.env KAPDH_BACKUP_SECRETS=/dev/null /opt/kapdh/infra/monitoring/check-host.sh 2>&1 | logger -t kapdh-check-host
*/5 * * * *  root  KAPDH_BACKUP_ENV=/etc/kapdh/monitoring.env KAPDH_BACKUP_SECRETS=/dev/null /opt/kapdh/infra/monitoring/check-app.sh 2>&1 | logger -t kapdh-check-app
*/2 * * * *  root  KAPDH_BACKUP_ENV=/etc/kapdh/monitoring.env KAPDH_BACKUP_SECRETS=/dev/null /opt/kapdh/infra/monitoring/check-worker.sh 2>&1 | logger -t kapdh-check-worker
*/2 * * * *  root  sh -c 'set -a; . /etc/kapdh/monitoring.env; exec node /opt/kapdh/infra/monitoring/realtime-probe.mjs' 2>&1 | logger -t kapdh-check-realtime
