# syntax=docker/dockerfile:1.26.0@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# Image web admin admin.kapdh.or.id (apps/admin, React 19 + Vite SPA, ARCHITECTURE §7; PRD 5.2, 7.1; D12; N-07; temuan
# audit D3-07). Dibangun di CI, bukan di VPS production (PRD 5.3, 10.2). Origin API dibakukan Vite saat build, jadi
# staging dan production adalah dua varian image dari commit yang sama (infra/ci/images.json):
#
#   docker build -f infra/Dockerfile.admin --build-arg VITE_API_BASE_URL=https://api.kapdh.or.id/api/v1 \
#     --build-arg KAPDH_COMMIT=$(git rev-parse HEAD) -t kapdh-admin:<versi> .
#   docker build -f infra/Dockerfile.admin --build-arg VITE_API_BASE_URL=https://staging-api.kapdh.or.id/api/v1 \
#     --build-arg KAPDH_COMMIT=$(git rev-parse HEAD) -t kapdh-admin:<versi>-staging .
#
# CSP nginx memakai origin API yang sama persis (infra/scripts/admin-csp.mjs render, bukan wildcard), lalu hasil build
# diperiksa gerbang CSP sebelum image jadi. Tidak ada secret di image: token akses admin hanya di memori, refresh
# cookie HttpOnly milik API (PRD 5.2). Base image dipin versi patch + digest (PRD 7.1); nginx berjalan sebagai user
# nginx (uid 101) di port 8080 (infra/nginx-main.conf).

# ------------------------------------------------------------------------------------------------ tahap build
FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /repo
ENV CI=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
# corepack mengunduh pnpm versi packageManager dari registry npm. Unduhan dipisah dari `pnpm fetch` dan dicoba ulang
# (maks. 5 kali, tiap percobaan maks. 120 s, jeda 10-40 s) agar gangguan sesaat registry (HTTP 5xx, koneksi macet) tidak
# menggagalkan build; pnpm sendiri mencoba ulang unduhan paket hingga 5 kali (bawaan 2). pnpm 10 membaca
# `npm_config_*`, pnpm 11 hanya `pnpm_config_*`; keduanya diisi agar tetap berlaku saat packageManager naik versi.
ENV npm_config_fetch_retries=5 \
    pnpm_config_fetch_retries=5
RUN for attempt in 1 2 3 4 5; do \
      timeout 120 corepack install && exit 0; \
      echo "corepack install gagal (percobaan ${attempt}/5)" >&2; \
      if [ "$attempt" -lt 5 ]; then sleep $((attempt * 10)); fi; \
    done; \
    exit 1
RUN --mount=type=cache,id=kapdh-pnpm-store,target=/pnpm/store \
    pnpm fetch --frozen-lockfile --store-dir /pnpm/store
COPY . .
# Basis URL API produksi bawaan (D12); staging memberi build arg sendiri. Hanya https://<host>/api/v1 (N-07): build
# tanpa URL API yang sah dihentikan, bukan diam-diam memakai origin admin.
ARG VITE_API_BASE_URL=https://api.kapdh.or.id/api/v1
RUN case "$VITE_API_BASE_URL" in \
      https://*/api/v1) ;; \
      *) echo "VITE_API_BASE_URL wajib https://<host>/api/v1, diterima: $VITE_API_BASE_URL" >&2; exit 1 ;; \
    esac
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
# Hanya admin dan dependensi workspace-nya (contracts, shared, design-tokens).
RUN --mount=type=cache,id=kapdh-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline --store-dir /pnpm/store --filter "@kapdh/admin..." \
  && pnpm --filter "@kapdh/admin..." build \
  && mkdir -p /out \
  && node infra/scripts/admin-csp.mjs render --api-base "$VITE_API_BASE_URL" --conf infra/nginx-admin.conf \
       --out /out/default.conf \
  && node infra/scripts/admin-csp.mjs check --dist apps/admin/dist --conf /out/default.conf \
       --api-base "$VITE_API_BASE_URL" \
  && grep -rqF "$VITE_API_BASE_URL" apps/admin/dist/assets \
  && ! grep -rqE "undangan-contoh-7Kq2M9xD4fW8pL3z|admin@kapdh\.test" apps/admin/dist/assets

# ---------------------------------------------------------------------------------------------- tahap runtime
# nginx 1.30.6 stable (Alpine 3.24), digest dipin (PRD 7.1).
FROM nginx:1.30.6-alpine3.24@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5
# Patch keamanan Alpine di atas digest yang dipin (mis. brotli-libs CVE-2026-111497; gerbang grype N-16), sama dengan
# Dockerfile.api dan Dockerfile.worker.
RUN apk upgrade --no-cache
# Konteks utama non-root (pid dan direktori sementara di /tmp, log tanpa query/IP) dan server admin hasil render.
COPY infra/nginx-main.conf /etc/nginx/nginx.conf
COPY --from=build /out/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/admin/dist /usr/share/nginx/html
# Commit sumber image di /version.json: uji asap deploy membuktikan kontainer yang melayani trafik adalah digest
# yang dipromosikan (infra/ci/smoke.mjs). Bukan secret.
ARG KAPDH_COMMIT=""
RUN case "$KAPDH_COMMIT" in \
      "") ;; \
      *[!0-9a-f]*) echo "KAPDH_COMMIT wajib 40 heksadesimal huruf kecil" >&2; exit 1 ;; \
      *) [ "${#KAPDH_COMMIT}" -eq 40 ] || { echo "KAPDH_COMMIT wajib 40 heksadesimal" >&2; exit 1; } ;; \
    esac \
  && printf '{"commit":"%s"}\n' "$KAPDH_COMMIT" > /usr/share/nginx/html/version.json
# Pengguna non-root `nginx` (uid 101) dari image resmi; berkas situs milik root dan hanya-baca.
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
STOPSIGNAL SIGQUIT
# Langsung nginx tanpa skrip docker-entrypoint.d (envsubst/IPv6 tidak dipakai; konfigurasi sudah final saat build).
ENTRYPOINT ["nginx", "-g", "daemon off;"]
