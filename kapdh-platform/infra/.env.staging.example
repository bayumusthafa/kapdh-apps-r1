# Contoh environment STAGING KAPDH (PRD 5.3; D12). Staging dan production memiliki database, user DB, Redis, volume
# berkas, secret, domain dan proyek push yang TERPISAH; jangan pernah menyalin secret production ke sini. Data staging
# sintetis saja (tidak ada data pribadi nyata). TANPA SECRET: setiap `ganti-dengan-...` wajib diganti.
#
# Compose cadangan (project kapdh-staging terpisah sehingga volume/jaringan tidak bercampur dengan production):
#   docker compose --env-file /etc/kapdh/staging.env -f infra/compose.production.yml -f infra/compose.staging.yml up -d
# Image web/admin staging dibangun dengan build arg API staging (PUBLIC_API_URL / VITE_API_BASE_URL di bawah).
# Buat secret acak: `openssl rand -hex 32`.

# ===================================================================================== A. bersama (API dan worker)
NODE_ENV=staging
LOG_LEVEL=debug
PUBLIC_WEB_URL=https://staging.kapdh.or.id
API_PUBLIC_URL=https://staging-api.kapdh.or.id
ADMIN_ORIGIN=https://staging-admin.kapdh.or.id
# Wajib di staging (OTP tidak boleh hanya dicetak ke log). Gunakan kredensial/sub-akun provider terpisah.
SMTP_URL=smtps://ganti-dengan-user:ganti-dengan-sandi@smtp.ganti-dengan-provider.example:465
MAIL_FROM="KAPDH Staging <noreply-staging@kapdh.or.id>"
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/files
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Hanya selama gladi perpindahan local -> S3 (docs/runbooks/storage-migration.md).
STORAGE_FALLBACK_LOCAL_ROOT=
FILE_URL_SECRET=ganti-dengan-32-karakter-acak-atau-lebih
# Proyek FCM staging terpisah (PRD 5.3). Kosong keduanya = push nonaktif di staging.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# GlitchTip proyek staging terpisah (docs/runbooks/monitoring.md bagian 5). Kosong = nonaktif.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# ================================================================================================== API saja
PORT=3000
TRUST_PROXY_HOPS=1
HSTS_ENABLED=false
JWT_ACCESS_SECRET=ganti-dengan-32-karakter-acak-atau-lebih
JWT_ISSUER=https://staging-api.kapdh.or.id
QR_SIGNING_KEYS=stg-2027a:ganti-dengan-32-karakter-acak-atau-lebih
OTP_HMAC_SECRET=ganti-dengan-32-karakter-acak-atau-lebih
TOTP_ENC_KEY=ganti-dengan-64-karakter-hex-dari-openssl-rand-hex-32
BCRYPT_COST=12

# =============================================================================================== worker saja
WORKER_CONCURRENCY=2
WORKER_HEALTH_PORT=3001
WORKER_HEALTH_HOST=0.0.0.0
OUTBOX_POLL_INTERVAL_MS=2000
WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Deletion ledger luar VPS (AC F14-6): opsional di staging, disarankan agar gladi restore setara production (bucket
# staging sendiri, bukan bucket production). Diisi lengkap bila dipakai; API tidak menerimanya.
DELETION_LEDGER_S3_ENDPOINT=
DELETION_LEDGER_S3_REGION=
DELETION_LEDGER_S3_BUCKET=
DELETION_LEDGER_S3_ACCESS_KEY_ID=
DELETION_LEDGER_S3_SECRET_ACCESS_KEY=
DELETION_LEDGER_S3_FORCE_PATH_STYLE=false

# ============================================== B. koneksi (Coolify: tulis lengkap per resource; Compose: abaikan)
# API    DATABASE_URL=postgres://kapdh_app:<KAPDH_APP_DB_PASSWORD>@<host-db-staging>:5432/kapdh
# worker DATABASE_URL=postgres://kapdh_worker:<KAPDH_WORKER_DB_PASSWORD>@<host-db-staging>:5432/kapdh
# rilis  ADMIN_DATABASE_URL / MIGRATOR_DATABASE_URL seperti production, ke database staging.
# API/worker REDIS_URL=redis://:<REDIS_PASSWORD>@<host-redis-staging>:6379/0

# ====================================================================================== C. Compose cadangan
KAPDH_REGISTRY=ghcr.io/ganti-dengan-organisasi
# api/worker/release memakai digest yang sama dengan production; web/admin memakai varian -staging (build arg
# berbeda). Pakai tag commit `sha-<commit 40 heksadesimal>` dari deploy-staging.yml: tag vX.Y.Z hanya diberikan pada
# varian production web/admin (release.yml), sehingga `vX.Y.Z-staging` tidak ada.
KAPDH_IMAGE_TAG=ganti-dengan-tag-rilis
# Domain staging dirutekan Traefik cadangan (infra/traefik/proxy.env.example, KAPDH_STAGING_DOMAIN_*). Project
# kapdh-staging, NODE_ENV staging, volume kapdh-staging-* dan direktori berkas /srv/kapdh/staging/files dipatok
# infra/compose.staging.yml (tidak dapat diarahkan ke data production lewat env).
POSTGRES_PASSWORD=ganti-dengan-64-karakter-hex
KAPDH_MIGRATOR_DB_PASSWORD=ganti-dengan-64-karakter-hex
KAPDH_APP_DB_PASSWORD=ganti-dengan-64-karakter-hex
KAPDH_WORKER_DB_PASSWORD=ganti-dengan-64-karakter-hex
# Opsional (backup/monitoring staging); kosong = tidak diubah job rilis.
KAPDH_BACKUP_DB_PASSWORD=
KAPDH_MONITOR_DB_PASSWORD=
# DSN GlitchTip proyek worker staging (Compose); kosong = nonaktif.
SENTRY_DSN_WORKER=
REDIS_PASSWORD=ganti-dengan-64-karakter-hex
# Staging: gerbang dilaporkan tanpa menahan rilis (data sintetis/fixture boleh). Gladi PRD 8.2 butir 7 dari database
# staging kosong wajib dijalankan dengan RELEASE_GATE=enforce dan lulus sebelum go-live.
RELEASE_GATE=report
# Hanya wajib untuk mode report di PRODUCTION; staging boleh kosong.
RELEASE_GATE_REASON=
RELEASE_GATE_APPROVER=
# Build arg image web/admin staging (CI): situs dan admin staging memanggil API staging.
PUBLIC_API_URL=https://staging-api.kapdh.or.id/api/v1
VITE_API_BASE_URL=https://staging-api.kapdh.or.id/api/v1
