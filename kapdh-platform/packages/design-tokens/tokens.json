{
  "$meta": {
    "name": "KAPDH Design Tokens",
    "version": "1.0.0",
    "source": "Guidelines KAPDH Platform v1.0 (warna disampel dari mockup), disesuaikan agar memenuhi kontras WCAG AA",
    "prd": "PRD KAPDH Apps v3.5, D15"
  },
  "color": {
    "brand": {
      "green-950": "#0E280C",
      "green-900": "#143A12",
      "green-800": "#1A4B17",
      "green-700": "#215E1E",
      "green-600": "#2D7A28",
      "green-500": "#3F9A38",
      "green-100": "#E3F0E1",
      "green-50": "#F1F8F0",
      "gold-500": "#E6D312",
      "gold-400": "#F0DD19",
      "gold-100": "#FBF6C9",
      "cream": "#FCF8F5"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F5F7F3",
      "100": "#F4F4F6",
      "200": "#E3E3E6",
      "300": "#C9C9C9",
      "500": "#8A8F87",
      "600": "#6B6B6B",
      "700": "#3F4A3E",
      "900": "#1C1B1F"
    },
    "semantic": {
      "primary": "{color.brand.green-800}",
      "on-primary": "{color.neutral.0}",
      "primary-hover": "{color.brand.green-700}",
      "accent": "{color.brand.gold-500}",
      "on-accent": "{color.brand.green-950}",
      "background": "{color.neutral.50}",
      "surface": "{color.neutral.0}",
      "surface-brand": "{color.brand.cream}",
      "surface-dark": "{color.brand.green-950}",
      "text": "{color.neutral.900}",
      "text-muted": "#5E665C",
      "text-on-dark": "{color.neutral.0}",
      "text-highlight-on-dark": "{color.brand.gold-500}",
      "border": "{color.neutral.500}",
      "divider": "#E1E6DE",
      "disabled-bg": "#E1E5DE",
      "disabled-text": "#5E665C",
      "focus-ring": "{color.brand.green-600}",
      "focus-ring-on-dark": "{color.brand.gold-500}",
      "card-border": "#E6EBE3",
      "tint": "{color.brand.green-50}",
      "tint-strong": "{color.brand.green-100}",
      "surface-raised": "{color.neutral.0}",
      "icon-accent": "{color.brand.green-600}",
      "skeleton": "#E4E9E1",
      "skeleton-shine": "#F0F3EE",
      "on-danger": "{color.neutral.0}"
    },
    "status": {
      "success": "#1E7A46",
      "success-bg": "#E8F7F0",
      "warning": "#8A5A00",
      "warning-bg": "#FFF4D6",
      "danger": "#B3261E",
      "danger-bg": "#FDECEA",
      "info": "#1F5FA8",
      "info-bg": "#E7F0FB",
      "neutral": "#3F4A3E",
      "neutral-bg": "#EEEFEE"
    },
    "membership": {
      "verified": {
        "fg": "{color.status.success}",
        "bg": "{color.status.success-bg}",
        "label": "KTA Aktif",
        "icon": "check_circle"
      },
      "expiring": {
        "fg": "{color.status.warning}",
        "bg": "{color.status.warning-bg}",
        "label": "Segera Berakhir",
        "icon": "schedule"
      },
      "expired": {
        "fg": "{color.status.danger}",
        "bg": "{color.status.danger-bg}",
        "label": "KTA Kedaluwarsa",
        "icon": "cancel"
      },
      "unverified": {
        "fg": "{color.status.danger}",
        "bg": "{color.status.danger-bg}",
        "label": "KTA Tidak Aktif",
        "icon": "cancel"
      },
      "pending_review": {
        "fg": "{color.status.info}",
        "bg": "{color.status.info-bg}",
        "label": "Menunggu Verifikasi",
        "icon": "hourglass_top"
      },
      "suspended": {
        "fg": "{color.status.neutral}",
        "bg": "{color.status.neutral-bg}",
        "label": "Dibatasi",
        "icon": "block"
      }
    }
  },
  "dark": {
    "$note": "Mode gelap v2 (mockup css/tokens.css :root[data-theme=dark]). Varian tonal lebih terang, bukan warna dibalik; pita merek hijau tetap.",
    "background": "#0F1A0E",
    "surface": "#172416",
    "surface-raised": "#1D2C1B",
    "neutral-100": "#222D21",
    "neutral-200": "#2B3929",
    "neutral-300": "#4A5648",
    "tint": "#1B2D19",
    "tint-strong": "#23401F",
    "text": "#E7ECE5",
    "text-muted": "#A5B0A2",
    "border": "#74806F",
    "divider": "#2B3929",
    "card-border": "#263424",
    "icon-accent": "#8BD47E",
    "primary": "#8BD47E",
    "on-primary": "#0E280C",
    "primary-hover": "#9EDD92",
    "disabled-bg": "#263124",
    "disabled-text": "#9AA597",
    "focus-ring": "#E6D312",
    "skeleton": "#243022",
    "skeleton-shine": "#2E3B2C",
    "success": "#6FD49B",
    "success-bg": "#10301E",
    "warning": "#F2C14E",
    "warning-bg": "#33270A",
    "danger": "#FF8A80",
    "danger-bg": "#3A1512",
    "on-danger": "#3A1512",
    "info": "#8DB8F2",
    "info-bg": "#13243A",
    "neutral": "#B8C2B5",
    "neutral-bg": "#2A332A",
    "rejection-border": "#5A2A26"
  },
  "gradient": {
    "kta-card": "linear-gradient(135deg, #020702 0%, #0E280C 45%, #215E1E 100%)",
    "button-primary": "linear-gradient(180deg, #215E1E 0%, #1A4B17 100%)",
    "header": "linear-gradient(180deg, #215E1E 0%, #1A4B17 100%)",
    "brand-mesh": "radial-gradient(circle at 92% 0%, rgba(230,211,18,0.20) 0, transparent 46%), radial-gradient(circle at 6% 100%, rgba(63,154,56,0.34) 0, transparent 55%), linear-gradient(135deg, #0E280C 0%, #1A4B17 55%, #215E1E 100%)",
    "splash": "linear-gradient(180deg, #FAFAFA 0%, #EEEFED 55%, #E2E4E1 100%)"
  },
  "font": {
    "family": {
      "heading": "Telegraf, Poppins, system-ui, sans-serif",
      "body": "Poppins, system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "note": "Telegraf adalah font berbayar; pakai hanya bila lisensi aplikasi dan web sudah dimiliki. Tanpa lisensi, heading memakai Poppins SemiBold.",
    "size": {
      "display": 32,
      "h1": 24,
      "h2": 20,
      "h3": 18,
      "body-lg": 16,
      "body": 14,
      "label": 14,
      "caption": 12,
      "overline": 11
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "line-height": { "tight": 1.2, "normal": 1.45, "relaxed": 1.6 }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "shadow": {
    "card": "0 1px 2px rgba(14,40,12,0.06), 0 4px 12px rgba(14,40,12,0.08)",
    "raised": "0 8px 24px rgba(14,40,12,0.16)"
  },
  "elevation": {
    "$note": "Bayangan v2 (Soft UI), daftar [x, y, blur, spread, warna ARGB]. Terang dan gelap. Dibangkitkan ke KapdhShadows (Dart) dan --elevation-* (CSS).",
    "light": {
      "xs": [[0, 1, 2, 0, "0x0F0E280C"]],
      "sm": [
        [0, 1, 2, 0, "0x0A0E280C"],
        [0, 2, 8, 0, "0x0F0E280C"]
      ],
      "md": [
        [0, 2, 4, 0, "0x0D0E280C"],
        [0, 8, 20, 0, "0x140E280C"]
      ],
      "lg": [
        [0, 4, 8, 0, "0x140E280C"],
        [0, 16, 40, 0, "0x2E0E280C"]
      ],
      "kta": [
        [0, 4, 8, 0, "0x24020702"],
        [0, 14, 32, 0, "0x470E280C"]
      ],
      "primary-button": [
        [0, 1, 2, 0, "0x290E280C"],
        [0, 4, 12, 0, "0x3D1A4B17"]
      ],
      "bar-top": [[0, -6, 20, 0, "0x0F0E280C"]],
      "brand-band": [[0, 12, 28, -10, "0x8C0E280C"]],
      "ring-focus-field": [[0, 0, 0, 4, "0x292D7A28"]]
    },
    "dark": {
      "xs": [[0, 1, 2, 0, "0x59000000"]],
      "sm": [
        [0, 1, 2, 0, "0x4D000000"],
        [0, 2, 8, 0, "0x47000000"]
      ],
      "md": [
        [0, 2, 4, 0, "0x52000000"],
        [0, 8, 20, 0, "0x5C000000"]
      ],
      "lg": [
        [0, 4, 8, 0, "0x5C000000"],
        [0, 16, 40, 0, "0x80000000"]
      ],
      "kta": [
        [0, 4, 8, 0, "0x59000000"],
        [0, 14, 32, 0, "0x80000000"]
      ],
      "primary-button": [
        [0, 1, 2, 0, "0x4D000000"],
        [0, 4, 12, 0, "0x2E8BD47E"]
      ],
      "bar-top": [[0, -6, 20, 0, "0x4D000000"]],
      "brand-band": [[0, 12, 28, -10, "0x99000000"]],
      "ring-focus-field": [[0, 0, 0, 4, "0x388BD47E"]]
    }
  },
  "motion": {
    "$note": "Durasi v2 (ms): tekan 100, hover/warna 150, indikator/chip/titik 250, sheet/dialog 350. Kurva di grup easing.",
    "press": 100,
    "fast": 150,
    "base": 250,
    "slow": 350
  },
  "easing": {
    "$note": "Kurva v2 sebagai cubic-bezier [x1, y1, x2, y2]: standard (M3) untuk perpindahan, out (easeOutCubic) untuk masuk/gulir.",
    "standard": [0.2, 0, 0, 1],
    "out": [0.215, 0.61, 0.355, 1]
  },
  "icon": { "xs": 14, "sm": 16, "button": 18, "md": 20, "lg": 24, "xl": 28 },
  "size": {
    "touch-target-min": 48,
    "input-height": 52,
    "button-height": 48,
    "app-bar-height": 56
  }
}
