{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapdh.or.id/contracts/events/realtime-reaction-count.schema.json",
  "title": "RealtimeReactionCount",
  "description": "Jumlah reaksi per emoji pada pesan, tanpa data per penerima (dipakai reaction.updated).",
  "type": "object",
  "required": ["emoji", "count"],
  "additionalProperties": false,
  "properties": {
    "emoji": { "type": "string", "minLength": 1, "maxLength": 16 },
    "count": { "type": "integer", "minimum": 1 }
  },
  "examples": [{ "emoji": "👍", "count": 3 }]
}
