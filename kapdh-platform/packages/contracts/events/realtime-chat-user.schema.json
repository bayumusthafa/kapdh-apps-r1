{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapdh.or.id/contracts/events/realtime-chat-user.schema.json",
  "title": "RealtimeChatUser",
  "description": "Identitas minimum anggota dalam chat (tanpa kontak). Bentuk JSON sama dengan ChatUserRef pada kontrak HTTP (chat.yaml).",
  "type": "object",
  "required": ["user_id", "full_name", "avatar_url"],
  "additionalProperties": false,
  "properties": {
    "user_id": { "type": "string", "format": "uuid" },
    "full_name": { "type": "string", "maxLength": 120 },
    "avatar_url": {
      "description": "URL avatar (publik atau bertanda tangan maksimal 10 menit, PRD 5.4).",
      "type": ["string", "null"],
      "format": "uri"
    }
  },
  "examples": [
    {
      "user_id": "0192f0c2-7c1e-7d5a-9a51-1f1c2b3d4e70",
      "full_name": "Ahmad Islam",
      "avatar_url": null
    }
  ]
}
