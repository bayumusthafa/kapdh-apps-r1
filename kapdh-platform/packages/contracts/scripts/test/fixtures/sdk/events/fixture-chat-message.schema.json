{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapdh.or.id/contracts/events/fixture-chat-message.schema.json",
  "title": "FixtureChatMessage",
  "description": "Fixture generator (bukan kontrak produk): skema bersama yang dirujuk payload lewat $id.",
  "type": "object",
  "required": ["id", "body", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "body": { "type": "string", "maxLength": 4000, "x-sensitive": true },
    "reply_to": { "oneOf": [{ "$ref": "#" }, { "type": "null" }] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "id": "0192f0c2-7c1e-7d5a-9a51-1f1c2b3d4e60",
      "body": "Assalamu'alaikum",
      "reply_to": null,
      "created_at": "2026-10-12T03:15:00.000Z"
    }
  ]
}
