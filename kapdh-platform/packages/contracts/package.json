{
  "name": "@kapdh/contracts",
  "version": "0.2.0",
  "private": true,
  "description": "Kontrak OpenAPI 3.1 KAPDH Apps, skema event realtime, tipe TypeScript dan SDK Dart terbangkit (PRD 5.2, N-13).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.yaml": "./dist/openapi.yaml",
    "./events/*": "./events/*"
  },
  "scripts": {
    "bundle": "node scripts/assemble.mjs",
    "lint": "node scripts/assemble.mjs && redocly lint dist/openapi.yaml && node scripts/validate-events.mjs && eslint scripts",
    "generate": "node scripts/assemble.mjs && node scripts/gen-ts.mjs && node scripts/gen-dart.mjs",
    "generate:dart": "node scripts/assemble.mjs && node scripts/gen-dart.mjs",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "test": "node --test scripts/test/*.test.mjs",
    "test:dart": "pnpm run generate:dart && node scripts/check-dart.mjs",
    "breaking": "node scripts/check-breaking.mjs",
    "release:dart": "node scripts/release-dart-sdk.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.62.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
